{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sportmonks Football Fixtures Predictions API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Predictions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Prediction Probabilities For Fixture",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sportmonks.com/v3/football/predictions/probabilities/fixtures/:fixtureId",
            "params": [
              {
                "name": "fixtureId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns outcome probabilities for a fixture."
        }
      ]
    }
  ],
  "bundled": true
}